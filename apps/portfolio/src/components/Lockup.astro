---
/**
 * The brand lockup that opens the home page.
 *
 * The blue square is a separate node so it can be animated on its own — it is
 * the page's one accent, and it lands last. Everything here is ordinary static
 * markup, so with JavaScript off the lockup is simply the finished lockup:
 * nothing is parked at opacity 0 waiting for a script, which is the mistake
 * the Next.js version of this site made.
 *
 * `size="nav"` renders the same mark small for the masthead, drawn identically
 * so the two read as one mark at two sizes.
 */
interface Props {
  size?: "hero" | "nav";
  class?: string;
}
const { size = "hero", class: className = "" } = Astro.props;
---

<div class:list={["lockup", `lockup--${size}`, className]}>
  <svg
    class="lockup__mark"
    viewBox="0 0 72 64"
    role="img"
    aria-label="Mortensen Web Co."
  >
    <path
      class="lockup__m"
      d="M14 47V17h7l11 16 11-16h7v30h-7V29L32 44 21 29v18z"
    ></path>
    <rect
      class="lockup__dot"
      x="57"
      y="37"
      width="10"
      height="10"></rect>
  </svg>

  {
    size === "hero" && (
      <>
        {/* The home page's one H1. It was a <p>, so the page had no main
            heading at all — the first thing search engines and screen readers
            look for. The visible wordmark is unchanged; the rest of the heading
            is for them, and says what and where. */}
        <h1 class="lockup__word">
          {/* The invisible space keeps the heading's text "Mortensen Web Co."
              for search engines; the wordmark itself is drawn joined. */}
          <span style="--i:0">Mortensen</span><span class="visually-hidden"> </span><em style="--i:1">Web</em><span class="visually-hidden"> </span>
          <span class="lockup__co" style="--i:2">
            Co.
          </span>
          <span class="visually-hidden"> — web design for small businesses in Riverton, Utah</span>
        </h1>
        <hr class="lockup__rule" />
        <p class="lockup__tagline">
          Small-business websites · Riverton, Utah · Built, hosted, looked after
        </p>
      </>
    )
  }
</div>
