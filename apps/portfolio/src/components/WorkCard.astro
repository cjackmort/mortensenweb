---
import { existsSync } from "node:fs";
import path from "node:path";
import type { Work } from "../data/work";
import { STATUS_LABEL } from "../data/work";
interface Props {
  work: Work;
  index: number;
  /** h2 on /work/, where the cards sit under the h1; h3 under a section's h2. */
  heading?: "h2" | "h3";
}
const { work, index, heading = "h2" } = Astro.props;
const Heading = heading;

/*
 * Prefer the screenshot scripts/sync-tiles.ts pulled from the site itself, and
 * fall back to the committed image when there is not one — the case for any
 * site not yet publishing `/__preview/home-tile.png`, and for entries that
 * never opted in. This tests for the file rather than trusting the flag,
 * because the script is allowed to fail: `autoTile` records that we try, not
 * that it worked.
 */
const auto = `/work/${work.slug}-auto.webp`;
const hasAuto =
  work.autoTile === true &&
  existsSync(path.join(process.cwd(), "public", `work/${work.slug}-auto.webp`));

const image = hasAuto ? auto : work.image;
const small = image.replace(/\.webp$/, "-640.webp");
// The width a phone actually picks. Checked for, because an auto tile written
// before the script made it has only the other two.
const medium = image.replace(/\.webp$/, "-800.webp");
const hasMedium = existsSync(path.join(process.cwd(), "public", medium));
const srcset = [`${small} 640w`, ...(hasMedium ? [`${medium} 800w`] : []), `${image} 1120w`].join(", ");
---

{/* The card as Wasatch Web lays theirs out — the screenshot first, then what
    the business is, the name, one line, the tags, and where it goes. */}
<a class="work reveal" href={work.href} target="_blank" rel="noopener noreferrer" data-umami-event={`work: ${work.name}`}>
  <figure>
    <img
      src={image}
      srcset={srcset}
      sizes="(max-width: 40rem) 100vw, (max-width: 70rem) 50vw, 33vw"
      width="1120"
      height="700"
      alt={work.imageAlt}
      loading={index === 0 ? "eager" : "lazy"}
      fetchpriority={index === 0 ? "high" : "auto"}
      decoding="async"
    />
  </figure>
  <div class="work__body">
    <div class="work__meta">
      <span class="work__sector">{work.sector}</span>
      <span class={`status status--${work.status}`}>{STATUS_LABEL[work.status]}</span>
    </div>
    <Heading class="h3">{work.name}</Heading>
    <p>{work.description}</p>
    <div class="tags">{work.tags.map((t) => <span>{t}</span>)}</div>
  </div>
  <p class="work__foot"><span>{work.domain}</span><span>Visit site ↗</span></p>
</a>
