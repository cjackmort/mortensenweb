---
import Base from "../layouts/Base.astro";
import { SITE } from "../data/site";
import { GROWTH_FEATURES } from "@mortensenweb/plans";

/*
 * One line per service: what it is, not how we do it. The operator's brief of
 * 2026-10-14. Growth tools read their status from `@mortensenweb/plans`, so
 * this page stops saying "rolling out" the day the last one switches on.
 */
const growthTools = GROWTH_FEATURES.filter((f) => f.key !== "leads");

const included: Array<{ title: string; body: string; soon?: string }> = [
  { title: "Design and build", body: "A custom site, written with you, built for phones first." },
  { title: "Hosting and security", body: "Hosting, SSL, domain, DNS and updates. In every plan." },
  { title: "Changes", body: "Ask in your portal. See a preview. Live when you approve." },
  { title: "Visitor analytics", body: "Visitors, top pages, sources and enquiries. No ad network." },
  { title: "Search basics", body: "Fast pages, real titles, structured data and a sitemap, so Google and AI assistants can find you." },
  { title: "Leads inbox", body: "Every contact-form enquiry in your portal. Reply from there. From Care." },
  {
    title: "Growth tools",
    body: `${growthTools.map((f) => f.name).join(", ")}. In Growth and Pro, or one at a time.`,
    soon: growthTools.some((f) => !f.available) ? "Rolling out" : undefined,
  },
  { title: "Ads", body: "Google, Facebook and Instagram ads, made from your business details. You pick where and set the budget.", soon: "Coming soon" },
];

const notIncluded = [
  ["Online stores", "We connect Square, Stripe or Shopify. The store stays on their platform, under your account."],
  ["Posting to social media", "We make graphics ready to post. Your accounts stay yours to run."],
];
---

<Base
  title="Small business web design services"
  description="Small business web design in Riverton, Utah: design and build, hosting, unlimited changes, a leads inbox and Growth tools — and what is not included."
  path="/services/"
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Services</p></div>
        <div>
          <h1 style="font-size: var(--text-2xl)">What we do.</h1>
        </div>
      </div>
      <ul class="rows">
        {included.map(({ title, body, soon }, i) => (
          <li class="reveal">
            <h2 class="h3"><span class="n">{String(i + 1).padStart(2, "0")}</span> {title}</h2>
            <p>
              {body}
              {title === "Growth tools" && <>{" "}<a class="link" href="/growth/">What each one does</a></>}
              {soon && <span class="soon">{soon}</span>}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Scope</p></div>
        <h2>What we don't do.</h2>
      </div>
      <ul class="rows">
        {notIncluded.map(([title, body]) => (
          <li class="reveal">
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <h2>Not sure what you need?</h2>
          <p class="lede" style="margin-top: 1rem">Tell us about the business. We'll say what would help.</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/">Start a project <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`} data-umami-event="emailed">Email us</a>
        </div>
      </div>
    </div>
  </section>
</Base>
