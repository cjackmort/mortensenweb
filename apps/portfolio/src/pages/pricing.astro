---
import Base from "../layouts/Base.astro";
import PlanCard from "../components/PlanCard.astro";
import { SITE } from "../data/site";
import {
  PLANS,
  OVERAGE_CENTS,
  dollars,
  CHEAPEST_PLAN,
  BUILDS,
  CHEAPEST_BUILD,
  GROWTH_FEATURES,
  type GrowthFeatureKey,
  type Plan,
} from "@mortensenweb/plans";

const faq = [
  ["What counts as a change?", "One request in the portal — a new photo, a price, a paragraph, a seasonal notice. If a request is really several unrelated things, we will say so and count it fairly rather than surprise you."],
  ["What does unlimited mean?", `Care, Growth and Pro have no monthly limit on changes. We work on one request at a time, so ask for the next whenever the last one is live. On Lite, a change beyond the one included is a flat ${dollars(OVERAGE_CENTS)}.`],
  // Both answers below changed on 2026-10-06, when the build stopped being one
  // price with a discount behind a twelve-month commitment and became three
  // standalone prices. Left as they were they would have quoted a commitment
  // that no longer exists.
  ["Is there a minimum term?", "No. Every plan is month to month, and the build has no strings attached — you can take a plan, change plans or stop whenever you like. The domain and the site stay yours."],
  ["What does the build cost?", `It depends on where the business is: ${BUILDS.map((b) => `${dollars(b.priceCents)} for ${b.name.toLowerCase()}`).join(", ")}. You do not need a plan to buy one. Without a plan, the site is handed over at launch on your own hosting account, at no monthly cost. Anything unusual we quote before you commit.`],
  ["Can I add one Growth tool without upgrading?", `Yes. Each Growth tool can be added to any plan on its own, from ${dollars(Math.min(...GROWTH_FEATURES.map((f) => f.addOnCents)))} a month, and removed again any time from your portal. If you want several, the plan that includes them usually costs less — the portal tells you when it does.`],
  ["What is not covered?", "A redesign or a new section is a project, quoted separately — typically $150–$400. Advertising is outside what we do, and an online store is something we connect rather than host — see Services."],
];

/** Whether a plan includes a Growth feature, for the comparison table. */
const has = (p: Plan, key: GrowthFeatureKey) => {
  if (!p.growthFeatures.includes(key)) return "—";
  return GROWTH_FEATURES.find((f) => f.key === key)!.available ? "✓" : "Soon";
};

/** Rows of the comparison table, so the markup below stays one loop per plan. */
const columns = [
  { head: "Per month", cell: (p: Plan) => dollars(p.monthlyCents), money: true },
  { head: "Changes / month", cell: (p: Plan) => String(p.includedChangesPerMonth ?? "Unlimited"), money: false },
  { head: "Extra change", cell: (p: Plan) => (p.overagePerChangeCents ? dollars(p.overagePerChangeCents) : "—"), money: false },
  { head: "Hosting · SSL · analytics", cell: () => "✓", money: false },
  { head: "Leads inbox", cell: (p: Plan) => has(p, "leads"), money: false },
  { head: "Reviews · QR campaigns", cell: (p: Plan) => has(p, "reviews"), money: false },
  { head: "Google profile · showcase · win-back", cell: (p: Plan) => has(p, "google-profile"), money: false },
];
---

<Base
  title="Website pricing for small businesses"
  description={`Small business website pricing: sites from ${dollars(CHEAPEST_BUILD.priceCents)}, plans from ${dollars(CHEAPEST_PLAN.monthlyCents)}/month, and unlimited changes plus Growth tools from ${dollars(PLANS[1]!.monthlyCents)}. No contracts.`}
  path="/pricing/"
  schema={[
    {
      "@type": "OfferCatalog",
      "@id": `${SITE.url}/pricing/#offers`,
      name: "Mortensen Web Co. pricing",
      itemListElement: [
        ...BUILDS.map((b) => ({
          "@type": "Offer",
          name: `${b.name} website build`,
          description: b.who,
          price: (b.priceCents / 100).toFixed(2),
          priceCurrency: "USD",
          seller: { "@id": `${SITE.url}/#organization` },
        })),
        ...PLANS.map((p) => ({
          "@type": "Offer",
          name: `${p.name} plan`,
          description: p.description,
          price: (p.monthlyCents / 100).toFixed(2),
          priceCurrency: "USD",
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: (p.monthlyCents / 100).toFixed(2),
            priceCurrency: "USD",
            unitText: "MONTH",
          },
          seller: { "@id": `${SITE.url}/#organization` },
        })),
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
    },
  ]}
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">01 · The build</p></div>
        <div>
          <h1 style="font-size: var(--text-2xl)">Priced by where your business is.</h1>
          <p class="lede" style="margin-top: 1rem">
            A business just starting out needs less than one with years of
            customers and search rankings to protect. Every build is mobile
            first, written with you, and launched on your domain — and none of
            them requires a plan.
          </p>
        </div>
      </div>

      <div class="builds builds--three">
        {BUILDS.map((build, index) => (
          <div class:list={["build", { "build--featured": index === 1 }]}>
            <p class="eyebrow">{build.name}</p>
            <p class="build__price">{dollars(build.priceCents)}<small>one-time</small></p>
            <p class="build__fine">{build.who}</p>
            <ul class="build__list">
              {build.includes.map((line) => <li>{line}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <p class="build__note">
        No plan? The site is still yours: we hand it over at launch on your own
        hosting account, with no monthly cost. Want changes later? Start any
        plan and the portal switches on. The build is invoiced half to start
        and half at launch.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">02 · Care plans</p></div>
        <div>
          <h2>Monthly, with no minimum term.</h2>
          <p class="lede" style="margin-top: 1rem">
            Every plan includes hosting, SSL, security updates and visitor
            analytics. Lite includes one change a month; from Care up, changes
            are unlimited and the plans add tools that bring in customers.
          </p>
        </div>
      </div>

      <div class="plans">
        {PLANS.map((plan) => <PlanCard plan={plan} />)}
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">03 · Side by side</p></div>
        <h2>The same numbers, as a table.</h2>
      </div>
      {/* Focusable because it scrolls sideways on a phone: a scroll container
          that cannot be reached by keyboard hides the columns past the fade
          from anyone not using a pointer. */}
      <div
        class="table-wrap reveal"
        tabindex="0"
        role="region"
        aria-label="Plan comparison table, scrolls sideways"
      >
        <table class="compare">
          <caption class="sr-only">Plan comparison by monthly price, included changes, and Growth tools. Soon means the tool is being built and is included when it arrives.</caption>
          <thead>
            <tr>
              <th scope="col">Plan</th>
              {columns.map((c) => <th scope="col">{c.head}</th>)}
            </tr>
          </thead>
          <tbody>
            {PLANS.map((p) => (
              <tr class={p.featured ? "is-featured" : undefined}>
                <th scope="row">
                  <span class="compare__plan">{p.name}{p.featured && <span class="compare__flag">most chosen</span>}</span>
                  <span class="compare__for">{p.bestFor.replace(/\.$/, "")}</span>
                </th>
                {columns.map((c) => (
                  <td class={c.money ? "compare__money" : undefined}>{c.cell(p)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="eyebrow table-hint">Swipe sideways for the last columns →</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">04 · Growth tools</p></div>
        <div>
          <h2>Add one tool on its own.</h2>
          <p class="lede" style="margin-top: 1rem">
            Every Growth tool is included in the plans above, or can be added to any plan for a monthly price —
            and removed again whenever you like. <a class="link" href="/growth/">What each tool does</a>.
          </p>
        </div>
      </div>
      <div class="table-wrap reveal" tabindex="0" role="region" aria-label="Growth tool prices, scrolls sideways">
        <table class="compare">
          <caption class="sr-only">Growth tools with their monthly price on their own, the plan that includes them, and whether they are available yet.</caption>
          <thead>
            <tr>
              <th scope="col">Tool</th>
              <th scope="col">On its own</th>
              <th scope="col">Included in</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {GROWTH_FEATURES.map((f) => (
              <tr>
                <th scope="row"><span class="compare__plan">{f.name}</span></th>
                <td class="compare__money">{dollars(f.addOnCents)}/month</td>
                <td>{PLANS.find((p) => p.key === f.includedFrom)!.name} and up</td>
                <td>{f.available ? "Live" : "Coming soon"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">05 · Questions</p></div>
        <h2>Before you pick one.</h2>
      </div>
      <ul class="rows">
        {faq.map(([q, a]) => (
          <li class="reveal"><h3>{q}</h3><p>{a}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <h2>Want a quote for the build?</h2>
          <p class="lede" style="margin-top: 1rem">Tell us about the business. We reply to every enquiry, including the ones where we are not the right fit.</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/">Start a project <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
