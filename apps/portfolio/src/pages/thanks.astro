---
import Base from "../layouts/Base.astro";
---
<Base title="Thanks" description="Your message is on its way." path="/thanks/" noindex>
  <section class="section">
    <div class="wrap">
      <div class="section-head" style="margin-bottom: 0">
        <div><p class="eyebrow">Sent</p></div>
        <div>
          <h1 style="font-size: var(--text-2xl)">Thanks — we've got it.</h1>
          <p class="lede" style="margin-top: 1rem">We usually reply the same working day. If you don't hear back within two, check your spam folder, then email us directly.</p>
          <div class="btn-row" style="margin-top: 2rem">
            <a class="btn btn--ghost" href="/">Back to the start</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
