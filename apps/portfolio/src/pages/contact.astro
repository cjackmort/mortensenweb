---
import Base from "../layouts/Base.astro";
import { SITE, START } from "../data/site";
import { BOOKING } from "../data/booking";
import { PLANS, dollars } from "@mortensenweb/plans";
/**
 * Netlify Forms, not a route handler. The form must exist in the built HTML
 * for Netlify's build step to detect it; `form-name` identifies the
 * submission; `action` must be a real built page; the honeypot is a field a
 * human never fills, positioned off-screen and hidden from assistive tech.
 *
 * "Book a call" sits beside the form only once `BOOKING_URL` is set in
 * src/data/booking.ts. Until then it is absent from the HTML, not hidden.
 */
---

<Base
  title="Contact — web design in Riverton, Utah"
  description="Contact Mortensen Web Co. in Riverton, Utah about a website for your small business. Call (801) 865-9235 or send an enquiry — we reply the same working day."
  path="/contact/"
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Contact</p></div>
        <div>
          <h1 style="font-size: var(--text-2xl)">See your site before you pay.</h1>
          <p class="lede" style="margin-top: 1rem">
            Tell us about the business. We build a demo of your site and send
            you the link, and you pay once you have approved it. Every enquiry
            gets an answer, including the ones where we are not the right fit.
          </p>
        </div>
      </div>

      <div class="section-head section-head--top" style="border-top: 0; margin-bottom: 0; padding-top: 0">
        <div>
          <p class="eyebrow" style="margin-bottom: .75rem">{BOOKING ? "Or call, email or book a call" : "Or call or email"}</p>
          <p><a class="link link--standalone" href={SITE.phoneHref} data-umami-event="called">{SITE.phone}</a></p>
          <p style="margin-top: .5rem"><a class="link link--standalone" href={`mailto:${SITE.email}`} data-umami-event="emailed">{SITE.email}</a></p>
          {BOOKING && (
            <p style="margin-top: 1.25rem">
              <a class="btn btn--ghost" href={BOOKING} data-umami-event="book a call">
                Book a call <span class="arrow">→</span>
              </a>
            </p>
          )}
          <p class="hint" style="margin-top: 1rem; color: var(--muted); font-size: var(--text-sm); max-width: 28ch">
            {SITE.founder}, {SITE.locality}, {SITE.region}.
          </p>
          <p class="hint" style="margin-top: 1.5rem; color: var(--muted); font-size: var(--text-sm); max-width: 28ch">
            We usually reply the same working day.
          </p>
        </div>

        <form class="form" name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company-website">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hp" aria-hidden="true">
            <label>Leave this field empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="grid-2">
            <div>
              <label for="name">Your name</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div>
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>

          <div>
            <label for="business">Business name</label>
            <input id="business" name="business" type="text" autocomplete="organization" required />
          </div>

          {/*
            The website question is a CSS-only disclosure: the radios are the
            only state, and `#has-site-yes:checked ~ .ask__more` reveals the
            URL field. Deliberately not JavaScript — this site ships no
            framework runtime and renders with scripts off, and a form that
            hides a field behind a script is a form that loses answers when
            the script does not run. The radios must stay direct siblings of
            `.ask__more` for the combinator to work; wrapping them in the
            layout div is what breaks it.
          */}
          <fieldset class="ask">
            <legend>Do you have a website already?</legend>
            <input class="ask__radio" type="radio" id="has-site-no" name="has-site" value="No" />
            <input class="ask__radio" type="radio" id="has-site-yes" name="has-site" value="Yes" />
            <div class="ask__choices">
              <label class="ask__btn" for="has-site-no">No</label>
              <label class="ask__btn" for="has-site-yes">Yes</label>
            </div>
            <div class="ask__more">
              <label for="current-site">Your current website</label>
              <input id="current-site" name="current-site" type="url" inputmode="url" placeholder="https://" />
              <p class="hint">Optional — a link just saves us asking.</p>
            </div>
          </fieldset>

          <div>
            {/*
              Was a budget range ("Under $1,500" upwards) until 2026-10-06,
              then a choice of three builds. Since 2026-10-21 the build is one
              price, so there is nothing to choose and only the plan is asked.
              The list comes from the plans package, so it cannot quote a
              different number from the pricing page.
            */}
            <label for="plan">Interested in a monthly plan?</label>
            <select id="plan" name="plan">
              <option value="">Not sure yet</option>
              <option value="none">No — just the site</option>
              {PLANS.map((p) => (
                <option value={p.key}>{p.name} — {dollars(p.monthlyCents)}/month</option>
              ))}
            </select>
            <p class="hint">Optional. You can start, change or stop a plan any time.</p>
          </div>

          <div>
            <label for="message">What do you need?</label>
            <textarea id="message" name="message" required placeholder="What the business does, who buys from you, and what is wrong with the site you have now."></textarea>
          </div>

          <div class="btn-row">
            <button class="btn btn--primary" type="submit" data-umami-event="enquiry sent">Send it <span class="arrow">→</span></button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">What happens next</p></div>
        <div>
          <h2>A demo first. Payment last.</h2>
          <p class="lede" style="margin-top: 1rem">
            Pricing is on the <a class="link" href="/pricing/">pricing page</a>, and everything else a
            website costs is in the <a class="link" href="/website-cost/">price guide</a>.
          </p>
        </div>
      </div>
      <ol class="rows">
        {START.map((step) => (
          <li class="reveal">
            <h3><span class="n">{step.n}</span> {step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
