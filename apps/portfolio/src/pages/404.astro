---
import Base from "../layouts/Base.astro";
---
<Base title="Not found" description="That page does not exist." path="/404/">
  <section class="section">
    <div class="wrap">
      <div class="section-head" style="margin-bottom: 0">
        <div><p class="eyebrow">404</p></div>
        <div>
          <h1 style="font-size: var(--text-2xl)">Nothing here.</h1>
          <p class="lede" style="margin-top: 1rem">The address may be old, or mistyped. Everything on the site is one of these.</p>
          <div class="btn-row" style="margin-top: 2rem">
            <a class="btn btn--ghost" href="/">Home</a>
            <a class="btn btn--ghost" href="/work/">Work</a>
            <a class="btn btn--ghost" href="/pricing/">Pricing</a>
            <a class="btn btn--ghost" href="/contact/">Contact</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
