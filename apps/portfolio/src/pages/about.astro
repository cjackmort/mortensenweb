---
import Base from "../layouts/Base.astro";
import { CHEAPEST_BUILD, CHEAPEST_PLAN, PLANS, dollars } from "@mortensenweb/plans";
import { SITE } from "../data/site";

/**
 * Who is behind the business, in plain facts.
 *
 * Answer engines and search both weigh a named, real person and a place: an
 * anonymous web studio is hard to recommend. Everything here is a fact the
 * operator confirmed — name, town, year, phone — and the opening paragraph is
 * written to be quoted on its own.
 */

/** The cheapest plan with unlimited changes, for the copy that leans on it. */
const unlimited = PLANS.find((p) => p.includedChangesPerMonth === null)!;

const facts: Array<[string, string]> = [
  ["Founder", SITE.founder],
  ["Based in", `${SITE.locality}, ${SITE.region}`],
  ["Founded", SITE.founded],
  ["Works with", "Small businesses in the Salt Lake Valley and anywhere in the US"],
  ["Websites from", `${dollars(CHEAPEST_BUILD.priceCents)}`],
  ["Plans from", `${dollars(CHEAPEST_PLAN.monthlyCents)} a month`],
  ["Phone", SITE.phone],
  ["Email", SITE.email],
];

const schema = [
  {
    "@type": "AboutPage",
    "@id": `${SITE.url}/about/#page`,
    url: `${SITE.url}/about/`,
    about: { "@id": `${SITE.url}/#organization` },
  },
  {
    "@type": "Person",
    "@id": `${SITE.url}/about/#founder`,
    name: SITE.founder,
    jobTitle: "Founder",
    worksFor: { "@id": `${SITE.url}/#organization` },
    homeLocation: { "@type": "Place", name: `${SITE.locality}, ${SITE.region}` },
  },
];
---

<Base
  title="About"
  description={`Mortensen Web Co. is a web design company in ${SITE.locality}, ${SITE.region}, founded in ${SITE.founded} by ${SITE.founder}, building and looking after small business websites.`}
  path="/about/"
  schema={schema}
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">About</p></div>
        <div>
          <h1 style="font-size: var(--text-2xl)">One person, a clear way of working, and no account managers.</h1>
          <p class="lede" style="margin-top: 1rem">
            Mortensen Web Co. is a web design company in {SITE.locality}, {SITE.region}, founded in {SITE.founded} by
            {" "}{SITE.founder}. It builds, hosts and looks after websites for small businesses — in the Salt Lake
            Valley and anywhere else, since everything happens online.
          </p>
        </div>
      </div>

      <dl class="about-facts">
        {facts.map(([term, value]) => (
          <div>
            <dt>{term}</dt>
            <dd>
              {term === "Phone" ? (
                <a href={SITE.phoneHref} data-umami-event="called">{value}</a>
              ) : term === "Email" ? (
                <a href={`mailto:${SITE.email}`} data-umami-event="emailed">{value}</a>
              ) : (
                value
              )}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">How it works</p></div>
        <h2>Why a small business gets a fast answer here.</h2>
      </div>
      <ul class="rows">
        <li class="reveal">
          <h3>You deal with the person who builds your site</h3>
          <p>
            There is no sales team and no hand-off. The person you talk to before the build is the person who
            builds it, hosts it and makes your changes afterwards.
          </p>
        </li>
        <li class="reveal">
          <h3>Most of the routine work is automated</h3>
          <p>
            Mortensen Web Co. runs on a client portal built in-house. A change you ask for is prepared, checked and
            shown to you as a preview — usually within the hour — and nothing goes live until you approve it. That is
            how one person can offer unlimited changes from {dollars(unlimited.monthlyCents)} a month.
          </p>
        </li>
        <li class="reveal">
          <h3>Your site, your domain, your choice</h3>
          <p>
            The domain stays in your name, plans are month to month, and a site built without a plan is handed over
            to you on your own hosting. You are never locked in.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <h2>Talk to {SITE.founder.split(" ")[0]} about your website.</h2>
          <p class="lede" style="margin-top: 1rem">
            Call <a href={SITE.phoneHref} class="link" data-umami-event="called">{SITE.phone}</a>, or tell us about the
            business and get a reply the same working day.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/" data-umami-event="cta: about start a project">Start a project <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>
