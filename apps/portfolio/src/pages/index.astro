---
import Base from "../layouts/Base.astro";
import Marquee from "../components/Marquee.astro";
import Lockup from "../components/Lockup.astro";
import WorkCard from "../components/WorkCard.astro";
import HeroField from "../react/HeroField";
import "../styles/home.css";
import { Font } from "astro:assets";
import { BUILD, CHEAPEST_PLAN, FREE_PORTAL, GROWTH_FEATURES, PLANS, dollars, isFree, type Plan } from "@mortensenweb/plans";
import { LOOP, SITE } from "../data/site";
import { WORK } from "../data/work";

/*
 * The operator's brief of 2026-10-21: keep this opening screen, and make the
 * rest as simple as wasatchweb.net — what we do, the work, the steps, the
 * price. One line per item, no explaining the process.
 *
 * Every price is read from `@mortensenweb/plans`, and the Growth tools by
 * name, so the day one switches on in the portal it stops saying "coming".
 */
const growthTools = GROWTH_FEATURES.filter((f) => !isFree(f));
const growthSoon = growthTools.some((f) => !f.available);
const growthFrom = PLANS.find((p) => growthTools.some((f) => f.includedFrom === p.key))!;
const [lite, care] = PLANS as [Plan, Plan];
const featuredWork = WORK.slice(0, 3);

/**
 * The four things we do. Each card under "What we do" is one line and a
 * "Learn more" link down to the same item under "About", which says it in
 * full and links out to the page that covers it — the operator's ask of
 * 2026-10-21.
 */
const services = [
  {
    id: "websites",
    n: "01",
    label: "Websites",
    title: "Websites",
    summary: `Designed, built and launched on your domain. Phone first. ${dollars(BUILD.priceCents)}, one time.`,
    detail:
      "A website designed around your business, not a template. We write it with you, build it for phones first, and launch it on your domain. It is yours, with or without a plan.",
    points: [
      ...BUILD.includes.slice(1),
      "Fast pages, real titles and structured data, so Google and AI assistants can find you",
    ],
    links: [
      { href: "/work/", label: "See sites we've built" },
      { href: "/pricing/", label: "What it costs" },
    ],
  },
  {
    id: "performance-tracking",
    n: "02",
    label: "Tracking",
    title: "Performance tracking",
    summary: "See who visits your site, how they found you, and every enquiry it brings in. Free with every site.",
    detail:
      "Know what your website is doing for you. Your client portal shows how many people visit, which pages they open and how they found you. Every enquiry from your contact form lands in a leads inbox, where you can reply to the customer and mark it contacted, won or lost.",
    points: [
      "Visitors, top pages and where they came from",
      "Every contact-form enquiry in one inbox",
      "Reply to customers from your portal",
      "You still get the usual email for every enquiry",
      "Free with every site, with or without a plan",
    ],
    links: [{ href: "/growth/#leads", label: "How the leads inbox works" }],
  },
  {
    id: "hosting-and-changes",
    n: "03",
    label: "Care",
    title: "Hosting and changes",
    summary: `Hosting, security updates and changes on request, in one monthly plan from ${dollars(CHEAPEST_PLAN.monthlyCents)}.`,
    detail:
      "We keep your site online, secure and up to date, and make the changes you ask for. Ask in your portal, check the preview, approve it, and it goes live — the same four steps every time.",
    points: [
      "Hosting, SSL, domain and DNS",
      "Security and dependency updates",
      `One change a month on ${lite.name}, unlimited from ${care.name}`,
      `Plans from ${dollars(CHEAPEST_PLAN.monthlyCents)} a month, with no contract`,
    ],
    links: [{ href: "/pricing/", label: "Compare plans" }],
  },
  {
    id: "growth-tools",
    n: "04",
    label: "Growth",
    title: "Growth tools",
    summary: `${growthTools.map((f) => f.name).join(", ")}.`,
    soon: growthSoon,
    detail: `Tools that turn visitors into customers. Each one is included from ${growthFrom.name} up, or can be added to any plan on its own.${
      growthSoon ? " They are being built now: each switches on in your portal the day it is ready, and is never charged for before then." : ""
    }`,
    points: growthTools.map((f) => `${f.name}${f.available ? "" : " (coming soon)"} — ${f.summary}`),
    links: [{ href: "/growth/", label: "Every Growth tool, in detail" }],
  },
];

const faq = [
  {
    q: "What does a website cost?",
    a: `${dollars(BUILD.priceCents)}, one time, designed and built for your business and launched on your domain. A monthly plan is optional; without one, the site is handed over at launch.`,
  },
  {
    q: "What is free?",
    a: "Performance tracking: visitor analytics and a leads inbox for every enquiry, in your client portal. It comes with every site we build, with or without a plan.",
  },
  {
    q: "How fast does a change happen?",
    a: "Small changes are usually ready to approve within the hour. Bigger ones take a day.",
  },
  {
    q: "Do I have to sign a contract?",
    a: "No. Plans are month to month. Your domain stays yours.",
  },
  {
    q: "Where is Mortensen Web Co. based?",
    a: `${SITE.locality}, ${SITE.region}. We work with small businesses across the Salt Lake Valley and anywhere online. ${SITE.phone} · ${SITE.email}.`,
  },
];

const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base path="/" schema={schema}>
  {/* Jost only here: it is the home page's display face, and loading it on
      /pricing/ would cost those pages a font they never set. Preloaded,
      because the lockup it sets is the first screen. */}
  <Fragment slot="head">
    <Font cssVariable="--font-jost" preload />
  </Fragment>

  {/* ------------------------------------------------------------ hero */}
  <section class="hero-sq sq">
    <div class="hero-sq__grid" aria-hidden="true"></div>
    {/* Answers to the pointer. Falls back to the static grid above it if it
        never mounts. `client:idle`, not `load`: the hero is complete without
        it, so React waits until the first paint is done. */}
    <HeroField client:idle />
    <Lockup />
    {/* The way to contact us from the first screen. Before this the only route
        from the home page was the masthead's "Client login" — which is for
        existing clients, not prospects — or scrolling the whole page to the
        CTA at the bottom. On a phone that is seven screens. */}
    <div class="hero-sq__cta">
      <a
        class="btn btn--primary"
        href="/contact/"
        data-umami-event="cta: hero start a project"
      >
        Start a project <span class="arrow">→</span>
      </a>
    </div>
    {/* A scroll cue: a line pointing down out of the lockup. */}
    <div class="hero-sq__path" aria-hidden="true"></div>
  </section>

  <Marquee />

  {/* ------------------------------------------------------- what we do */}
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">What we do</p></div>
        <div>
          <h2>Websites that bring in work.</h2>
          {/* The page's plain statement of who and where, written to be quoted
              on its own by search and AI answers. */}
          <p class="lede" style="margin-top: 1rem">
            {SITE.name} builds, hosts and looks after websites for small businesses in
            {" "}{SITE.locality}, {SITE.region} and anywhere online.
          </p>
        </div>
      </div>

      <ul class="cells">
        {services.map((item) => (
          <li class="reveal">
            <p class="n">{item.n} / {item.label}</p>
            <h3>{item.title}</h3>
            <p>
              {item.summary}
              {item.soon && <span class="soon">Rolling out</span>}
            </p>
            <a class="link cell__more" href={`#${item.id}`}>Learn more →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------ work */}
  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Our work</p></div>
        <div>
          <h2>Sites we have built.</h2>
          <p class="lede" style="margin-top: 1rem">
            Each one is linked, and labelled: client site, demo, or our own.
          </p>
        </div>
      </div>
      <div class="work-grid">
        {featuredWork.map((work, i) => <WorkCard work={work} index={i + 1} heading="h3" />)}
      </div>
      <p class="eyebrow" style="margin-top: var(--space-5)">
        <a class="link" href="/work/">See all our work →</a>
      </p>
    </div>
  </section>

  {/* --------------------------------------------------------- the steps */}
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">How it works</p></div>
        <div>
          <h2>Website changes, made easy.</h2>
          <p class="lede" style="margin-top: 1rem">Every change to your site goes through the same four steps.</p>
        </div>
      </div>
      <ol class="cells">
        {LOOP.map((step) => (
          <li class="reveal">
            <p class="n">Step {step.n}</p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ----------------------------------------------------------- about */}
  {/* Each "Learn more" under What we do lands on its own row here. */}
  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">About</p></div>
        <div>
          <h2>What each one does, in more detail.</h2>
        </div>
      </div>
      <ul class="rows">
        {services.map((item) => (
          <li class="reveal" id={item.id}>
            <h3><span class="n">{item.n}</span> {item.title}</h3>
            <div>
              <p>{item.detail}</p>
              <ul class="ticks">
                {item.points.map((point) => <li>{point}</li>)}
              </ul>
              <p class="more-links">
                {item.links.map((l) => <a class="link" href={l.href}>{l.label} →</a>)}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* --------------------------------------------------------- pricing */}
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Pricing</p></div>
        <div>
          <h2>One price for the site. Performance tracking is free.</h2>
          <p class="lede" style="margin-top: 1rem">
            Then a monthly plan if you want us to host it and keep it current. No contracts.
          </p>
        </div>
      </div>
      <ul class="cells">
        <li class="reveal">
          <p class="n">{BUILD.name}</p>
          <p class="cell__price">{dollars(BUILD.priceCents)}<small>one time</small></p>
          <p>Designed, built and launched on your domain. No plan required.</p>
        </li>
        <li class="reveal">
          <p class="n">{FREE_PORTAL.name}</p>
          <p class="cell__price">Free</p>
          <p>Visitor analytics and a leads inbox, with or without a plan.</p>
        </li>
        <li class="reveal">
          <p class="n">Plans</p>
          <p class="cell__price">{dollars(CHEAPEST_PLAN.monthlyCents)}<small>/month and up</small></p>
          <p>{PLANS.map((p) => `${p.name} ${dollars(p.monthlyCents)}`).join(" · ")}. Month to month.</p>
          <a class="link cell__more" href="/pricing/">Compare plans →</a>
        </li>
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------- faq */}
  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Questions</p></div>
        <h2>What people ask before they get in touch.</h2>
      </div>
      <ul class="rows">
        {
          faq.map((f) => (
            <li class="reveal">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------- cta */}
  <section class="section section--dark">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <h2>Let's talk about your site.</h2>
          <p class="lede" style="margin-top: 1rem">
            Tell us about the business. You get a straight answer and a price.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/" data-umami-event="cta: start a project">Start a project <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`} data-umami-event="emailed">{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
