---
import Base from "../layouts/Base.astro";
import Marquee from "../components/Marquee.astro";
import Lockup from "../components/Lockup.astro";
import HeroField from "../react/HeroField";
import "../styles/home.css";
import PlanCard from "../components/PlanCard.astro";
import { PLANS, dollars, BUILDS, CHEAPEST_BUILD, CHEAPEST_PLAN, GROWTH_FEATURES } from "@mortensenweb/plans";
import { SITE } from "../data/site";

/*
 * Copy on this page names what we do and stops. One line per item, no
 * explaining the process — the operator's brief of 2026-10-14, after
 * comparing with wasatchweb.net.
 *
 * The Growth tools are read from `@mortensenweb/plans` rather than written
 * out, so the day one switches on in the portal it stops saying "coming".
 */
const comingTools = GROWTH_FEATURES.filter((f) => !f.available);
const liveTools = GROWTH_FEATURES.filter((f) => f.available);
const growthTools = GROWTH_FEATURES.filter((f) => f.key !== "leads");

const faq = [
  {
    q: "How fast does a change happen?",
    a: "Small changes are usually ready to approve within the hour. Bigger ones take a day.",
  },
  {
    q: "What if the change isn't right?",
    a: "Say so on the preview and we fix it. It still counts as one change.",
  },
  {
    q: "Where is Mortensen Web Co. based?",
    a: `${SITE.locality}, ${SITE.region}. We work with small businesses across the Salt Lake Valley and anywhere online. ${SITE.phone} · ${SITE.email}.`,
  },
  {
    q: "What are Growth tools?",
    a: `Tools that turn your website into more customers. Live now: ${liveTools.map((f) => f.name).join(", ")}.${comingTools.length ? ` Coming: ${comingTools.map((f) => f.name).join(", ")}.` : ""} Included from ${PLANS[1]!.name}, or added one at a time.`,
  },
  {
    q: "Do I have to sign a contract?",
    a: "No. Month to month. Your domain stays yours.",
  },
  {
    q: "What does the build cost?",
    a: `${BUILDS.map((b) => `${dollars(b.priceCents)} for ${b.name}`).join(", ")}. A plan is optional; without one, the site is handed over at launch.`,
  },
];

const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base path="/" schema={schema}>
  {/* Jost only here: it is the home page's display face, and loading it on
      /pricing/ would cost those pages a font they never set. */}
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400&display=swap"
  />

  {/* ------------------------------------------------------------ hero */}
  <section class="hero-sq sq">
    <div class="hero-sq__grid" aria-hidden="true"></div>
    {/* Answers to the pointer. Falls back to the static grid above it if it
        never mounts. */}
    <HeroField client:load />
    <Lockup />
    {/* The way to contact us from the first screen. Before this the only route
        from the home page was the masthead's "Client login" — which is for
        existing clients, not prospects — or scrolling the whole page to the
        CTA at the bottom. On a phone that is seven screens. */}
    <div class="hero-sq__cta">
      <a
        class="btn btn--primary"
        href="/contact/"
        data-umami-event="cta: hero start a project"
      >
        Start a project <span class="arrow">→</span>
      </a>
    </div>
    {/* A scroll cue: a line pointing down out of the lockup. */}
    <div class="hero-sq__path" aria-hidden="true"></div>
  </section>

  <Marquee />

  {/* ------------------------------------------------------- what we do */}
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">What we do</p></div>
        <div>
          <h2>Websites that bring in work.</h2>
          {/* The page's plain statement of who and where, written to be quoted
              on its own by search and AI answers. */}
          <p class="lede" style="margin-top: 1rem">
            {SITE.name} builds, hosts and looks after websites for small businesses in
            {" "}{SITE.locality}, {SITE.region} and anywhere online.
          </p>
        </div>
      </div>

      <ul class="rows">
        <li class="reveal">
          <h3><span class="n">A</span> Websites</h3>
          <p>Designed, built and launched on your domain. Phone first.</p>
        </li>
        <li class="reveal">
          <h3><span class="n">B</span> Hosting and care</h3>
          <p>Hosting, SSL, domain and security updates in one monthly plan.</p>
        </li>
        <li class="reveal">
          <h3><span class="n">C</span> Changes</h3>
          <p>Ask in your portal. Live when you approve it.</p>
        </li>
        <li class="reveal">
          <h3><span class="n">D</span> Leads inbox</h3>
          <p>Every enquiry in one place. Reply from there.</p>
        </li>
        <li class="reveal">
          <h3><span class="n">E</span> Growth tools</h3>
          <p>
            {growthTools.map((f) => f.name).join(", ")}.
            {" "}<a class="link" href="/growth/">What each one does</a>
            {growthTools.some((f) => !f.available) && <span class="soon">Rolling out</span>}
          </p>
        </li>
        <li class="reveal">
          <h3><span class="n">F</span> Ads</h3>
          <p>
            Google, Facebook and Instagram, made from your business details. You pick where and set the budget.
            <span class="soon">Coming soon</span>
          </p>
        </li>
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------ the loop */}
  <section class="sq-stage sq" aria-label="How a change happens">
   <div class="stage__inner">
    {/* The rail duplicates the step names that are already in each step, so
        it is hidden from assistive tech and from narrow screens; there the
        steps carry their own `01 ·` labels instead. */}
    <aside class="rail" aria-hidden="true">
      <p class="rail__title">How a change happens</p>
      <div class="rail__track">
        <span class="rail__fill"></span>
        <ol class="rail__list">
          <li class="rail__step" data-step="1"><b>01</b> You ask</li>
          <li class="rail__step" data-step="2"><b>02</b> We build it</li>
          <li class="rail__step" data-step="3"><b>03</b> You approve</li>
          <li class="rail__step" data-step="4"><b>04</b> It's live</li>
        </ol>
      </div>
    </aside>

    <div class="stage__steps">
    {/* 01 */}
    <div class="dock dock--ask" data-dock="1">
      <div class="dock__inner">
        <div>
          <p class="dock__n">01 · You ask</p>
          <h2 class="dock__h">
            {
              "In your own words.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">Type it in your portal. Add a photo if it helps.</p>
        </div>
        <div class="dock__slot">
          <div class="dock__field">
            <span>Swap the hero photo for the one from Saturday</span>
            <span class="dock__square"></span>
          </div>
        </div>
      </div>
    </div>

    {/* 02 */}
    <div class="dock dock--build" data-dock="2">
      <div class="dock__inner">
        <div>
          <p class="dock__n">02 · We build it</p>
          <h2 class="dock__h">
            {
              "On a copy, not your live site.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">Ready to check, usually within the hour.</p>
        </div>
        <div class="dock__slot">
          <div class="dock__panel">
            <p class="dock__n" style="padding: 1rem 1.25rem; margin: 0">
              preview · a private address
            </p>
            <span class="dock__square"></span>
          </div>
        </div>
      </div>
    </div>

    {/* 03 — the square at its largest: it *is* the approve button. The stage
        stays dark the whole way through, because a blue plane here would be a
        blue surface that is not the square, and the page only has one rule. */}
    <div class="dock dock--approve" data-dock="3">
      <div class="dock__inner">
        <div>
          <p class="dock__n">03 · You approve</p>
          <h2 class="dock__h">
            {
              "One tap, on your phone.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">Not right? Say so. A redo is free.</p>
        </div>
        <div class="dock__slot">
          <span class="dock__approve">
            <span class="dock__square"></span>
            <span class="dock__approve-label">Approve</span>
          </span>
        </div>
      </div>
    </div>

    {/* 04 */}
    <div class="dock dock--live" data-dock="4">
      <div class="dock__inner">
        <div>
          <p class="dock__n">04 · It's live</p>
          <h2 class="dock__h">
            {
              "And we check that it is.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">We load your site to make sure, then tell you.</p>
        </div>
        <div class="dock__slot">
          <span class="dock__live">
            <span class="dock__square"></span> Live
          </span>
        </div>
      </div>
    </div>

    </div>
   </div>

    {/* The stage ends by handing the page back to daylight: paper wipes up
        over the dark as you leave the last step, so the change in ground
        reads as a deliberate act rather than a seam between two designs. */}
    <div class="stage-out" aria-hidden="true"></div>
  </section>


  {/* ------------------------------------------------------- numbers */}
  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">In your portal</p></div>
        <h2>The numbers, every month.</h2>
      </div>
      <ul class="rows">
        <li class="reveal">
          <h3>Visitors</h3>
          <p>Who came, what they opened, how they found you.</p>
        </li>
        <li class="reveal">
          <h3>Calls and enquiries</h3>
          <p>What the site brought in, beside the visitor numbers.</p>
        </li>
        <li class="reveal">
          <h3>Every change</h3>
          <p>Asked, built, approved, live. On the record.</p>
        </li>
      </ul>
    </div>
  </section>

  {/* --------------------------------------------------------- pricing */}
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Pricing</p></div>
        <div>
          <h2>Priced so you can plan for it.</h2>
          <p class="lede" style="margin-top: 1rem">
            Sites from {dollars(CHEAPEST_BUILD.priceCents)}. Plans from
            {" "}{dollars(CHEAPEST_PLAN.monthlyCents)} a month. No contracts.
          </p>
        </div>
      </div>
      <div class="plans">
        {PLANS.map((plan) => <PlanCard plan={plan} compact />)}
      </div>
      <p class="eyebrow" style="margin-top: 1rem">
        <a class="link" href="/pricing/">See all three build prices and compare every plan</a>
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------- faq */}
  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Straight answers</p></div>
        <h2>The questions people ask before they get in touch.</h2>
      </div>
      <ul class="rows">
        {
          faq.map((f) => (
            <li class="reveal">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* --------------------------------------------- existing clients */}
  <section class="section">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <p class="eyebrow" style="margin-bottom: 1rem">Already a client?</p>
          <h2>Your portal is here.</h2>
          <p class="lede" style="margin-top: 1rem">
            Requests, previews, visitor numbers and invoices.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={SITE.portalUrl}>Go to the client portal <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href={`${SITE.portalUrl}/get-started`}>First time signing in</a>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- cta */}
  <section class="section section--dark">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <h2>Let's talk about your site.</h2>
          <p class="lede" style="margin-top: 1rem">
            Tell us about the business. You get a straight answer and a price.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/" data-umami-event="cta: start a project">Start a project <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`} data-umami-event="emailed">{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
