---
import Base from "../layouts/Base.astro";
import Marquee from "../components/Marquee.astro";
import Lockup from "../components/Lockup.astro";
import SquareFlight from "../react/SquareFlight";
import HeroField from "../react/HeroField";
import "../styles/home.css";
import PlanCard from "../components/PlanCard.astro";
import {
  PLANS,
  dollars,
  BUILD_PRICE_CENTS,
  BUILD_WITH_CARE_CENTS,
  BUILD_DISCOUNT_CENTS,
  BUILD_COMMITMENT_MONTHS,
} from "@mortensenweb/plans";
import { SITE } from "../data/site";

const soldPlans = PLANS.filter((p) => p.key !== "care-unlimited");

const faq = [
  {
    q: "How fast does a change actually happen?",
    a: "Most changes — a photo, a price, a line of text — are built and waiting for your approval within the hour. Bigger ones, like a new section, can take a day. You are emailed the moment a preview is ready, and again when it is live.",
  },
  {
    q: "What if the change is not what I wanted?",
    a: "Say so on the preview. Asking for changes on a preview does not use up another of your monthly changes; it is part of the same request until you are happy with it.",
  },
  // Both answers changed on 2026-09-05, when the build stopped being "quoted"
  // and got a published price. Left as they were they would have contradicted
  // the number now sitting further up the same page.
  {
    q: "Do I have to sign a contract?",
    a: `Only if you take the discounted build. ${dollars(BUILD_WITH_CARE_CENTS)} assumes you stay on a care plan for ${BUILD_COMMITMENT_MONTHS} months, and leaving early invoices the unused part of the ${dollars(BUILD_DISCOUNT_CENTS)} pro-rata — nothing else. Pay ${dollars(BUILD_PRICE_CENTS)} for the build and there is no commitment at all. Your domain stays yours either way.`,
  },
  {
    q: "What does the build cost?",
    a: `${dollars(BUILD_PRICE_CENTS)} for the site on its own, or ${dollars(BUILD_WITH_CARE_CENTS)} if you start a care plan with it — the same site either way, up to five pages. After that the monthly plan is the only recurring cost.`,
  },
];

const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base path="/" schema={schema}>
  {/* Jost only here: it is the home page's display face, and loading it on
      /pricing/ would cost those pages a font they never set. */}
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400&display=swap"
  />

  {/* ------------------------------------------------------------ hero */}
  <section class="hero-sq sq">
    <div class="hero-sq__grid" aria-hidden="true"></div>
    {/* Answers to the pointer and to the square as it passes. Falls back
        to the static grid above it if it never mounts. */}
    <HeroField client:load />
    <Lockup />
    {/* Where the square is about to go, hinted before it moves. */}
    <div class="hero-sq__path" aria-hidden="true"></div>
  </section>

  <Marquee />

  {/* ------------------------------------------------------- what we do */}
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">What we do</p></div>
        <h2>Three things, done properly. Nothing you will not use.</h2>
      </div>

      <ul class="rows">
        <li class="reveal">
          <h3><span class="n">A</span> Design and build</h3>
          <p>
            A site structured around the handful of things a visitor actually
            came to find — what you make, what it costs, how to reach you.
            Written with you, using your photographs, laid out for a phone
            first. Not a template with your name typed in.
          </p>
        </li>
        <li class="reveal">
          <h3><span class="n">B</span> Hosting and care</h3>
          <p>
            Hosting, SSL, domain configuration, and security updates are part
            of the plan, not a separate bill. We check your site is up and
            serving; if something breaks, fixing it is our problem, not a
            ticket you have to chase.
          </p>
        </li>
        <li class="reveal">
          <h3><span class="n">C</span> Changes on request</h3>
          <p>
            New photos, a changed price, a seasonal note at the top of the
            page. You ask in the portal, we make the change and show you a
            preview before it goes live. Every plan includes a monthly
            allowance; extras are a flat $25.
          </p>
        </li>
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------ the loop */}
  {/* --------------------------------------------- the square's journey */}
  <section class="sq-stage" aria-label="How a change happens">
    {/* 01 */}
    <div class="dock dock--ink dock--ask sq" data-dock="1">
      <div class="dock__inner">
        <div>
          <p class="dock__n">01 · You ask</p>
          <h2 class="dock__h">
            {
              "In your own words.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">
            In your portal, however you'd say it out loud. Attach a photo if it
            helps — a picture of the thing you mean is usually faster than
            describing it.
          </p>
        </div>
        <div class="dock__slot">
          <div class="dock__field">
            <span>Swap the hero photo for the one from Saturday</span>
            <span class="dock__square"></span>
          </div>
        </div>
      </div>
    </div>

    {/* 02 */}
    <div class="dock dock--ink-2 dock--build sq" data-dock="2">
      <div class="dock__inner">
        <div>
          <p class="dock__n">02 · We build it</p>
          <h2 class="dock__h">
            {
              "On a copy, not your live site.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">
            The change is made, checked — every link, every image — and put up
            at a private address. Usually within the hour.
          </p>
        </div>
        <div class="dock__slot">
          <div class="dock__panel">
            <p class="dock__n" style="padding: 1rem 1.25rem; margin: 0">
              preview · a private address
            </p>
            <span class="dock__square"></span>
          </div>
        </div>
      </div>
    </div>

    {/* 03 — the square at its largest: it *is* the approve button. This
        stage stays dark the whole way through, because a blue plane here
        would be a blue surface that is not the square, and the page only
        has one rule. */}
    <div class="dock dock--ink dock--approve sq" data-dock="3">
      <div class="dock__inner">
        <div>
          <p class="dock__n">03 · You approve</p>
          <h2 class="dock__h">
            {
              "One tap, on your phone.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">
            You get an email with the preview and a picture of the change.
            Looks right? Approve it. Not quite? Say what's off — it doesn't
            cost another change.
          </p>
        </div>
        <div class="dock__slot">
          <span class="dock__approve">
            <span class="dock__square"></span>
            <span class="dock__approve-label">Approve</span>
          </span>
        </div>
      </div>
    </div>

    {/* 04 */}
    <div class="dock dock--ink-2 dock--live sq" data-dock="4">
      <div class="dock__inner">
        <div>
          <p class="dock__n">04 · It's live</p>
          <h2 class="dock__h">
            {
              "And we check that it is.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">
            We publish, fetch your live site to confirm it actually serves the
            change, and tell you. Then it shows up in your visitor numbers like
            everything else.
          </p>
        </div>
        <div class="dock__slot">
          <span class="dock__live">
            <span class="dock__square"></span> Live
          </span>
        </div>
      </div>
    </div>

    {/* The stage ends by handing the page back to daylight: paper wipes up
        over the dark as you leave the last step, so the change in ground
        reads as a deliberate act rather than a seam between two designs. */}
    <div class="stage-out" aria-hidden="true"></div>

    <SquareFlight client:idle />
  </section>


  {/* ------------------------------------------------------- numbers */}
  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">What you get every month</p></div>
        <h2>You see the numbers. We see the problems first.</h2>
      </div>
      <ul class="rows">
        <li class="reveal">
          <h3>Who came, and from where</h3>
          <p>
            Visitors, the pages they opened, how they found you, and which
            photos people stop on — in plain words, in your portal, on every
            plan. Privacy-respecting analytics, not an ad network.
          </p>
        </li>
        <li class="reveal">
          <h3>Who got in touch</h3>
          <p>
            Calls and emails from the site are counted beside the visitors,
            so you know whether the website is bringing work in — not only
            whether people looked at it.
          </p>
        </li>
        <li class="reveal">
          <h3>Every change, on the record</h3>
          <p>
            Each request has its own timeline in the portal — sent, built,
            what we changed in plain words, approved, live — so you never
            have to ask where something got to.
          </p>
        </li>
      </ul>
    </div>
  </section>

  {/* --------------------------------------------------------- pricing */}
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Pricing</p></div>
        <div>
          <h2>Priced so you can plan for it.</h2>
          <p class="lede" style="margin-top: 1rem">
            The site is {dollars(BUILD_PRICE_CENTS)} on its own, or
            {" "}{dollars(BUILD_WITH_CARE_CENTS)} when you start a care plan with
            it — {dollars(BUILD_DISCOUNT_CENTS)} off for staying
            {" "}{BUILD_COMMITMENT_MONTHS} months. After launch, one monthly plan
            covers hosting, security, analytics and an allowance of changes —
            so keeping the site current is a fixed cost, not a decision every
            time.
          </p>
        </div>
      </div>
      <div class="plans">
        {soldPlans.map((plan) => <PlanCard plan={plan} compact />)}
      </div>
      <p class="eyebrow" style="margin-top: 1rem">
        Unlimited changes: {dollars(PLANS[3]!.monthlyCents)}/month · <a class="link" href="/pricing/">see both build prices and compare every plan</a>
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------- faq */}
  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Straight answers</p></div>
        <h2>The questions people ask before they get in touch.</h2>
      </div>
      <ul class="rows">
        {
          faq.map((f) => (
            <li class="reveal">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* --------------------------------------------- existing clients */}
  <section class="section">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <p class="eyebrow" style="margin-bottom: 1rem">Already a client?</p>
          <h2>Your portal is here.</h2>
          <p class="lede" style="margin-top: 1rem">
            Request a change, see a preview before it goes live, check your
            visitor numbers, and view invoices. First time? Use the username
            and temporary password from your welcome email.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={SITE.portalUrl}>Go to the client portal <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href={`${SITE.portalUrl}/get-started`}>First time signing in</a>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- cta */}
  <section class="section section--dark">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <h2>Let's talk about your site.</h2>
          <p class="lede" style="margin-top: 1rem">
            Tell us about the business and what you need. We will come back
            with a straight answer about whether we are a good fit and what
            it would cost — including when the answer is that your current
            site is fine.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/" data-umami-event="cta: start a project">Start a project <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`} data-umami-event="emailed">{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
