---
import Base from "../layouts/Base.astro";
import Marquee from "../components/Marquee.astro";
import Lockup from "../components/Lockup.astro";
import HeroField from "../react/HeroField";
import "../styles/home.css";
import PlanCard from "../components/PlanCard.astro";
import {
  PLANS,
  dollars,
  BUILD_PRICE_CENTS,
  BUILD_WITH_CARE_CENTS,
  BUILD_DISCOUNT_CENTS,
  BUILD_COMMITMENT_MONTHS,
  OVERAGE_CENTS,
} from "@mortensenweb/plans";
import { SITE } from "../data/site";

const soldPlans = PLANS.filter((p) => p.key !== "care-unlimited");

const faq = [
  {
    q: "How fast does a change actually happen?",
    a: "Most of the time — a photo, a price, a line of text — it will be waiting for your approval within the hour. Something bigger, like a whole new section, might take a day.",
  },
  {
    q: "What if the change is not what I wanted?",
    a: "Just tell us on the preview. We keep working on it until you are happy, and it still counts as the one change.",
  },
  // Both answers changed on 2026-09-05, when the build stopped being "quoted"
  // and got a published price. Left as they were they would have contradicted
  // the number now sitting further up the same page.
  {
    q: "Do I have to sign a contract?",
    a: `Only if you take the discounted build. The ${dollars(BUILD_WITH_CARE_CENTS)} price assumes you stay on a care plan for ${BUILD_COMMITMENT_MONTHS} months — leave early and we invoice the unused part of the ${dollars(BUILD_DISCOUNT_CENTS)} pro-rata, nothing else. Pay ${dollars(BUILD_PRICE_CENTS)} up front and you are not committed to anything. Either way, your domain stays yours.`,
  },
  {
    q: "What does the build cost?",
    a: `${dollars(BUILD_PRICE_CENTS)} for the site on its own, or ${dollars(BUILD_WITH_CARE_CENTS)} if you start a care plan with it. You get the same site either way, up to five pages, and after that the monthly plan is your only recurring cost.`,
  },
];

const schema = [
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base path="/" schema={schema}>
  {/* Jost only here: it is the home page's display face, and loading it on
      /pricing/ would cost those pages a font they never set. */}
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400&display=swap"
  />

  {/* ------------------------------------------------------------ hero */}
  <section class="hero-sq sq">
    <div class="hero-sq__grid" aria-hidden="true"></div>
    {/* Answers to the pointer. Falls back to the static grid above it if it
        never mounts. */}
    <HeroField client:load />
    <Lockup />
    {/* The way to contact us from the first screen. Before this the only route
        from the home page was the masthead's "Client login" — which is for
        existing clients, not prospects — or scrolling the whole page to the
        CTA at the bottom. On a phone that is seven screens. */}
    <div class="hero-sq__cta">
      <a
        class="btn btn--primary"
        href="/contact/"
        data-umami-event="cta: hero start a project"
      >
        Start a project <span class="arrow">→</span>
      </a>
    </div>
    {/* A scroll cue: a line pointing down out of the lockup. */}
    <div class="hero-sq__path" aria-hidden="true"></div>
  </section>

  <Marquee />

  {/* ------------------------------------------------------- what we do */}
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">What we do</p></div>
        <h2>Three things, done properly. Nothing you won't use.</h2>
      </div>

      <ul class="rows">
        <li class="reveal">
          <h3><span class="n">A</span> Design and build</h3>
          <p>
            We build the site the way you want it. We get on a call, you tell
            us what it needs to do, and we make it happen — your words, your
            photos, laid out for a phone first. No strong feelings about the
            design? We'll come back with something that suits the business, and
            you tell us what to change.
          </p>
        </li>
        <li class="reveal">
          <h3><span class="n">B</span> Hosting and care</h3>
          <p>
            Hosting, SSL, your domain and the security updates are all in your
            plan, not a separate bill. We watch that the site is up and
            serving, and if something breaks, fixing it is our job — not a
            ticket you have to chase us about.
          </p>
        </li>
        <li class="reveal">
          <h3><span class="n">C</span> Changes on request</h3>
          <p>
            Need something changed? Ask in the portal, in your own words. We
            make the change and show you a preview, and it only goes live when
            you say so. Every plan includes a monthly allowance; anything past
            that is a flat {dollars(OVERAGE_CENTS)}.
          </p>
        </li>
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------ the loop */}
  <section class="sq-stage sq" aria-label="How a change happens">
   <div class="stage__inner">
    {/* The rail duplicates the step names that are already in each step, so
        it is hidden from assistive tech and from narrow screens; there the
        steps carry their own `01 ·` labels instead. */}
    <aside class="rail" aria-hidden="true">
      <p class="rail__title">How a change happens</p>
      <div class="rail__track">
        <span class="rail__fill"></span>
        <ol class="rail__list">
          <li class="rail__step" data-step="1"><b>01</b> You ask</li>
          <li class="rail__step" data-step="2"><b>02</b> We build it</li>
          <li class="rail__step" data-step="3"><b>03</b> You approve</li>
          <li class="rail__step" data-step="4"><b>04</b> It's live</li>
        </ol>
      </div>
    </aside>

    <div class="stage__steps">
    {/* 01 */}
    <div class="dock dock--ask" data-dock="1">
      <div class="dock__inner">
        <div>
          <p class="dock__n">01 · You ask</p>
          <h2 class="dock__h">
            {
              "In your own words.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">
            Tell us in the portal, however you'd say it out loud. If a photo
            explains it faster, send that instead.
          </p>
        </div>
        <div class="dock__slot">
          <div class="dock__field">
            <span>Swap the hero photo for the one from Saturday</span>
            <span class="dock__square"></span>
          </div>
        </div>
      </div>
    </div>

    {/* 02 */}
    <div class="dock dock--build" data-dock="2">
      <div class="dock__inner">
        <div>
          <p class="dock__n">02 · We build it</p>
          <h2 class="dock__h">
            {
              "On a copy, not your live site.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">
            We work on a copy, never your live site. It's checked and waiting
            for you at a private address, usually within the hour.
          </p>
        </div>
        <div class="dock__slot">
          <div class="dock__panel">
            <p class="dock__n" style="padding: 1rem 1.25rem; margin: 0">
              preview · a private address
            </p>
            <span class="dock__square"></span>
          </div>
        </div>
      </div>
    </div>

    {/* 03 — the square at its largest: it *is* the approve button. The stage
        stays dark the whole way through, because a blue plane here would be a
        blue surface that is not the square, and the page only has one rule. */}
    <div class="dock dock--approve" data-dock="3">
      <div class="dock__inner">
        <div>
          <p class="dock__n">03 · You approve</p>
          <h2 class="dock__h">
            {
              "One tap, on your phone.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">
            It arrives by email. Looks right? Approve it. Not quite? Tell us
            what's off — that doesn't use up another change.
          </p>
        </div>
        <div class="dock__slot">
          <span class="dock__approve">
            <span class="dock__square"></span>
            <span class="dock__approve-label">Approve</span>
          </span>
        </div>
      </div>
    </div>

    {/* 04 */}
    <div class="dock dock--live" data-dock="4">
      <div class="dock__inner">
        <div>
          <p class="dock__n">04 · It's live</p>
          <h2 class="dock__h">
            {
              "And we check that it is.".split(" ").map((w, i) => (
                <span class="w" style={`--w:${i}`}>{w}&#32;</span>
              ))
            }
          </h2>
          <p class="dock__p">
            We publish it, then load your site ourselves to make sure the
            change is really there — and tell you when it is.
          </p>
        </div>
        <div class="dock__slot">
          <span class="dock__live">
            <span class="dock__square"></span> Live
          </span>
        </div>
      </div>
    </div>

    </div>
   </div>

    {/* The stage ends by handing the page back to daylight: paper wipes up
        over the dark as you leave the last step, so the change in ground
        reads as a deliberate act rather than a seam between two designs. */}
    <div class="stage-out" aria-hidden="true"></div>
  </section>


  {/* ------------------------------------------------------- numbers */}
  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">What you get every month</p></div>
        <h2>You see the numbers. We see the problems first.</h2>
      </div>
      <ul class="rows">
        <li class="reveal">
          <h3>Who came, and from where</h3>
          <p>
            You see who visited, what they opened and how they found you — in
            plain words, on every plan. Privacy-friendly, not an ad network.
          </p>
        </li>
        <li class="reveal">
          <h3>Who got in touch</h3>
          <p>
            We count the calls and emails your site brings in, right beside the
            visitor numbers — so you know it's actually working for you, not
            just being looked at.
          </p>
        </li>
        <li class="reveal">
          <h3>Every change, on the record</h3>
          <p>
            Every request you send gets its own timeline in the portal — sent,
            built, approved, live. You never have to ask us where something
            got to.
          </p>
        </li>
      </ul>
    </div>
  </section>

  {/* --------------------------------------------------------- pricing */}
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Pricing</p></div>
        <div>
          <h2>Priced so you can plan for it.</h2>
          <p class="lede" style="margin-top: 1rem">
            The site is {dollars(BUILD_PRICE_CENTS)}, or
            {" "}{dollars(BUILD_WITH_CARE_CENTS)} if you start a care plan with
            it — that's {dollars(BUILD_DISCOUNT_CENTS)} off for staying
            {" "}{BUILD_COMMITMENT_MONTHS} months. After launch, one monthly
            plan covers your hosting, security, analytics and changes.
          </p>
        </div>
      </div>
      <div class="plans">
        {soldPlans.map((plan) => <PlanCard plan={plan} compact />)}
      </div>
      <p class="eyebrow" style="margin-top: 1rem">
        Unlimited changes: {dollars(PLANS[3]!.monthlyCents)}/month · <a class="link" href="/pricing/">see both build prices and compare every plan</a>
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------- faq */}
  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Straight answers</p></div>
        <h2>The questions people ask before they get in touch.</h2>
      </div>
      <ul class="rows">
        {
          faq.map((f) => (
            <li class="reveal">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* --------------------------------------------- existing clients */}
  <section class="section">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <p class="eyebrow" style="margin-bottom: 1rem">Already a client?</p>
          <h2>Your portal is here.</h2>
          <p class="lede" style="margin-top: 1rem">
            Request a change, look at a preview, check your visitor numbers,
            grab an invoice. First time signing in? Use the details from your
            welcome email.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={SITE.portalUrl}>Go to the client portal <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href={`${SITE.portalUrl}/get-started`}>First time signing in</a>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- cta */}
  <section class="section section--dark">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <h2>Let's talk about your site.</h2>
          <p class="lede" style="margin-top: 1rem">
            Tell us about the business and what you need. You get a straight
            answer on whether we're a good fit and what it would cost —
            including if that answer is that your current site is fine as it is.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/" data-umami-event="cta: start a project">Start a project <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href={`mailto:${SITE.email}`} data-umami-event="emailed">{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
