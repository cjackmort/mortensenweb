---
import Base from "../layouts/Base.astro";
import { ADD_ON_FEATURES, GROWTH_FEATURES, PLANS, dollars, isFree, type GrowthFeature } from "@mortensenweb/plans";
import { SITE } from "../data/site";

/**
 * Growth: the tools beyond the website itself, for search and for sale.
 *
 * Every figure comes from `@mortensenweb/plans` — what each tool costs on its
 * own, which plan includes it, and whether it is built yet. A tool that is not
 * built says "coming soon" here exactly as it does in the portal, so this page
 * can never sell something a client cannot use. A free tool (the leads inbox,
 * since 2026-10-21) says "free" and quotes no price.
 *
 * Written answer-first for AI answer engines: each section opens with a
 * sentence that stands on its own when quoted, naming the business and the
 * tool rather than "it".
 */

const planName = (key: GrowthFeature["includedFrom"]) => PLANS.find((p) => p.key === key)!.name;
/** "Free with every site", or "Included in Growth and above, or $35 a month on its own." */
const howToGet = (f: GrowthFeature) =>
  isFree(f)
    ? "Free with every site we build, with or without a plan."
    : `Included in ${planName(f.includedFrom)} and above, or ${dollars(f.addOnCents)} a month on its own.`;
const live = GROWTH_FEATURES.filter((f) => f.available);
/** "a leads inbox, review requests, …" — every tool, for sentences that list them. */
/** "Leads inbox" → "leads inbox" mid-sentence; "QR …" and "Google …" keep their capitals. */
const midSentence = (name: string) => (/^(QR|Google)/.test(name) ? name : name[0].toLowerCase() + name.slice(1));
const allNames = GROWTH_FEATURES.map((f) => midSentence(f.name));
const allNamesSentence = `${allNames.slice(0, -1).join(", ")} and ${allNames[allNames.length - 1]}`;
/** "The leads inbox and online shop are" / "The leads inbox is" — the free ones. */
const freeNames = GROWTH_FEATURES.filter(isFree).map((f) => midSentence(f.name));
const freeSentence = `${freeNames.length > 1 ? `${freeNames.slice(0, -1).join(", ")} and ${freeNames[freeNames.length - 1]} are` : `${freeNames[0]} is`}`;
/** Every tool switched on — then nothing on this page may say "being built". */
const allLive = live.length === GROWTH_FEATURES.length;
const cheapestAddOn = Math.min(...ADD_ON_FEATURES.map((f) => f.addOnCents));
const allTogether = ADD_ON_FEATURES.reduce((sum, f) => sum + f.addOnCents, 0);
const firstPaidPlan = PLANS.find((p) => ADD_ON_FEATURES.some((f) => f.includedFrom === p.key))!;
const pro = PLANS.find((p) => p.key === "pro")!;

/** Each tool's section heading, phrased the way people ask about it. */
const QUESTION: Record<GrowthFeature["key"], string> = {
  leads: "What is the leads inbox?",
  campaigns: "How does QR & campaign tracking work?",
  reviews: "How do review requests work?",
  winback: "What are win-back emails?",
  showcase: "What is a job showcase?",
  "google-profile": "What does Google profile management include?",
  shop: "How does the online shop work?",
};

/** What each tool is, said plainly — the answer-first lead for its section. */
const LEAD: Record<GrowthFeature["key"], string> = {
  leads:
    "The Mortensen Web Co. leads inbox puts every contact-form enquiry from your website into your client portal, where you can read it, reply to the customer by email, and mark it contacted, won or lost.",
  campaigns:
    "QR & campaign tracking gives each piece of print — a door hanger, flyer, yard sign or truck wrap — its own QR code and link, so your monthly report shows which campaign brought in visits and enquiries.",
  reviews:
    "Review requests send your customers a short email with a direct link to leave a Google review, plus one reminder, so asking every customer takes one click instead of remembering to do it.",
  winback:
    "Win-back emails are seasonal reminders and offers to your past customers, drafted for you from what your business does, approved by you, and sent from the portal.",
  showcase:
    "Job showcase turns a few photos of a finished job into a project page on your website, a Google Business Profile post and ready-made social graphics.",
  "google-profile":
    "Google profile management means Mortensen Web Co. keeps your Google Business Profile current for you: regular posts, accurate hours and photos, and replies to reviews.",
  shop:
    "The online shop lets you add products, photos and stock in your client portal and sell them from a shop page on your website. Customers pay by card through Stripe, into your own Stripe account, and every order and its stock count sits in the portal.",
};

const faq: Array<[string, string]> = [
  [
    "What are Growth tools?",
    `Growth tools are the parts of Mortensen Web Co. that bring a small business more customers, beyond the website itself: ${allNamesSentence}. The ${freeSentence} free with every site; the rest are included from the ${firstPaidPlan.name} plan up, or can be added one at a time.`,
  ],
  [
    "Can I add one Growth tool without changing my plan?",
    `Yes${allLive ? "" : ", once it is ready"}. Every paid Growth tool can be added on its own, from ${dollars(cheapestAddOn)} a month, and removed whenever you like. If you want several, the plan that includes them is usually cheaper — the portal tells you when it is.`,
  ],
  [
    "Which Growth tools are available today?",
    allLive
      ? `All of them: ${live.map((f) => f.name).join(", ")}. Each one is live in the client portal now.`
      : `${live.map((f) => f.name).join(", ")} ${live.length === 1 ? "is" : "are"} live now. The others are being built and switch on in your portal the day they are ready; they are never charged for before then.`,
  ],
  [
    "Do I still get an email when someone fills in my contact form?",
    "Yes. You still get the usual email for every enquiry. The leads inbox adds one place to see them all, reply from, and keep track of which turned into work.",
  ],
  [
    "How much does it cost to get every Growth tool?",
    `Everything is included in the ${pro.name} plan at ${dollars(pro.monthlyCents)} a month. Bought one at a time, the paid tools would cost ${dollars(allTogether)} a month on top of a plan.`,
  ],
];

const schema = [
  {
    "@type": "Service",
    "@id": `${SITE.url}/growth/#service`,
    name: "Growth tools for small business websites",
    serviceType: "Small business marketing tools",
    provider: { "@id": `${SITE.url}/#organization` },
    areaServed: { "@type": "Country", name: "United States" },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Growth tools",
      itemListElement: ADD_ON_FEATURES.map((f) => ({
        "@type": "Offer",
        name: f.name,
        description: f.summary,
        price: (f.addOnCents / 100).toFixed(2),
        priceCurrency: "USD",
        availability: f.available ? "https://schema.org/InStock" : "https://schema.org/PreOrder",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: (f.addOnCents / 100).toFixed(2),
          priceCurrency: "USD",
          unitText: "MONTH",
        },
      })),
    },
  },
  {
    "@type": "FAQPage",
    mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
];
---

<Base
  title="Growth tools for small business websites"
  description={`Growth tools for small business websites: a free leads inbox, then review requests, QR campaign tracking and more, from ${dollars(cheapestAddOn)}/month or included from ${dollars(firstPaidPlan.monthlyCents)}.`}
  path="/growth/"
  schema={schema}
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Growth</p></div>
        <div>
          <h1 style="font-size: var(--text-2xl)">A website that brings in customers, not just visitors.</h1>
          <p class="lede" style="margin-top: 1rem">
            Every enquiry in one inbox, more Google reviews, and proof of which marketing pays off.
          </p>
        </div>
      </div>

      <ul class="keyfacts">
        <li><strong>{GROWTH_FEATURES.length} Growth tools</strong>{allLive ? "All live in your portal today." : `${live.length} live today; the rest switch on as they are ready.`}</li>
        <li><strong>{freeNames.length > 1 ? "Inbox and shop are free" : "The inbox is free"}</strong>Every enquiry in your portal{freeNames.length > 1 ? ", and a shop when you want one" : ""}, with every site we build.</li>
        <li><strong>The rest from {firstPaidPlan.name}</strong>{dollars(firstPaidPlan.monthlyCents)}/month, with every tool in {pro.name} at {dollars(pro.monthlyCents)}. Or one at a time, from {dollars(cheapestAddOn)}/month.</li>
        <li><strong>No contracts</strong>Month to month. Cancel any time.</li>
      </ul>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">01 · The tools</p></div>
        <h2>Every Growth tool, what it costs, and which plan includes it.</h2>
      </div>
      <div class="table-wrap reveal" tabindex="0" role="region" aria-label="Growth tools comparison table, scrolls sideways">
        <table class="compare">
          <caption class="sr-only">Growth tools by what they do, the plan that includes them{allLive ? " and" : ","} their price on their own{allLive ? "" : ", and whether they are available yet"}.</caption>
          <thead>
            <tr>
              <th scope="col">Tool</th>
              <th scope="col">What it does</th>
              <th scope="col">Included in</th>
              <th scope="col">On its own</th>
              {!allLive && <th scope="col">Status</th>}
            </tr>
          </thead>
          <tbody>
            {GROWTH_FEATURES.map((f) => (
              <tr>
                <th scope="row"><span class="compare__plan">{f.name}</span></th>
                <td>{f.summary}</td>
                <td>{isFree(f) ? "Every site, free" : `${planName(f.includedFrom)} and up`}</td>
                <td class="compare__money">{isFree(f) ? "Free" : `${dollars(f.addOnCents)}/mo`}</td>
                {!allLive && <td>{f.available ? "Live" : "Coming soon"}</td>}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="eyebrow table-hint">Swipe sideways for the last columns →</p>
      </div>
    </div>
  </section>

  {GROWTH_FEATURES.map((f, i) => (
    <section class="section growth-tool" id={f.key}>
      <div class="wrap">
        <div class="section-head reveal">
          <div>
            <p class="eyebrow">{String(i + 2).padStart(2, "0")} · {f.available ? "Live now" : "Coming soon"}</p>
          </div>
          <div>
            <h2>{QUESTION[f.key]}</h2>
            <p class="lede" style="margin-top: 1rem">{LEAD[f.key]}</p>
            <p style="margin-top: 1rem"><strong>Why it matters:</strong> {f.benefit}</p>
            <p class="build__fine" style="margin-top: 1rem">
              {howToGet(f)}
              {!f.available && " Being built now — it switches on in your portal the day it is ready, and is never charged for before then."}
            </p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <div><p class="eyebrow">Questions</p></div>
        <h2>About Growth tools.</h2>
      </div>
      <ul class="rows">
        {faq.map(([q, a]) => (
          <li class="reveal"><h3>{q}</h3><p>{a}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="cta reveal">
        <div>
          <h2>Want your website working harder?</h2>
          <p class="lede" style="margin-top: 1rem">
            Tell us about the business. We'll say which of these would help, if any.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/" data-umami-event="cta: growth start a project">Start a project <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href="/pricing/">Compare plans</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
