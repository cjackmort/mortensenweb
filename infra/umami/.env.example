# Umami host — variable NAMES only. NEVER put real values in this file.
#
# Copy to `.env` beside docker-compose.yml on the VPS. `.env` is gitignored and
# must never be committed: this repository is public.

# Postgres password for the umami database.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Signs Umami sessions and tokens. Generate ONCE. Changing it later logs
# everyone out and invalidates issued tokens.
#   openssl rand -base64 32
APP_SECRET=

# Public hostname this instance answers on. Must resolve to this VPS before
# starting, or Let's Encrypt cannot validate and no certificate is issued.
#   e.g. analytics.mortensenweb.com
#   or, without owning a domain yet: analytics.203-0-113-45.sslip.io
ANALYTICS_HOSTNAME=

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=
