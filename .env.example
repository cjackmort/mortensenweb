# =============================================================================
# Mortensen Web Co. — environment variable NAMES
# =============================================================================
#
# THIS FILE CONTAINS NAMES ONLY. NEVER PUT A REAL VALUE HERE.
#
# Copy to .env.local for local development (.env.local is git-ignored).
# In production, these are Cloudflare Worker secrets — not files, not committed.
#
#   wrangler secret put <NAME>
#
# The "Lives in" column below is authoritative. If a secret ends up anywhere
# other than where it says, that is a security incident, not a convenience.
# =============================================================================


# ---- Core application -------------------------------------------------------
# Lives in: Worker secret (prod) / .env.local (dev)

# Postgres connection string from the Neon dashboard.
DATABASE_URL=

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical origin of the portal, e.g. https://portal.mortensenweb.com
AUTH_URL=

# Public base URL of the marketing site, e.g. https://mortensenweb.com
NEXT_PUBLIC_SITE_URL=


# ---- Cloudflare R2 (change-request attachments, screenshots) -----------------
# Lives in: wrangler.jsonc binding — no access key needed in application code.
# Named here only so the binding name is discoverable.
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=


# ---- Analytics (Umami) ------------------------------------------------------
# Lives in: Worker secret. NEVER expose to the browser — the portal proxies all
# Umami calls server-side. A NEXT_PUBLIC_ prefix on the API key would be a leak.
#
# The base URL must INCLUDE the API path prefix, because Cloud and self-hosted
# differ and the application deliberately does not guess:
#
#   Umami Cloud   https://api.umami.is/v1
#   self-hosted   https://umami.your-vps.example/api
#
# Per-site website IDs are not secrets and are not set here — they are recorded
# against each site in the portal (Clients -> the client -> Sites & analytics).
UMAMI_API_BASE_URL=
UMAMI_API_KEY=


# ---- Email (Resend) ---------------------------------------------------------
# Lives in: Worker secret.
# In development, leave RESEND_API_KEY empty: the mailer falls back to logging
# messages to the console instead of sending. Never let dev silently send mail.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO=


# ---- GitHub App (portal -> client repositories) -----------------------------
# Lives in: Worker secret. The private key is a multi-line PEM; store it as a
# single secret value, never as a file in the repository.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Where client repositories are created, and what they are generated from.
# Not secret — these are account and repository names.
#
# The template must be a real repository with "Template repository" ticked in
# its settings. See templates/client-repo/README.md.
GITHUB_REPO_OWNER=
GITHUB_TEMPLATE_OWNER=
GITHUB_TEMPLATE_REPO=
# The App's installation id on the owner account. Visible in the installation
# settings URL: .../settings/installations/<id>
GITHUB_INSTALLATION_ID=


# ---- Netlify (hosting for client sites) -------------------------------------
# Lives in: Worker secret.
#
# The portal uses this to CREATE sites and read deploys. It deliberately does
# not link repositories to Netlify — that needs their GitHub App's per-account
# installation id, which is only issued through a browser OAuth flow. Client
# repositories deploy themselves from their own workflow instead, using an
# account-level NETLIFY_AUTH_TOKEN in GitHub Actions secrets.
NETLIFY_AUTH_TOKEN=
# Only needed on a team account; a personal account has exactly one.
NETLIFY_ACCOUNT_SLUG=
# Netlify's load balancer IP, used in the DNS instructions we email clients.
# Documented as stable; overridable so a change is not a code deploy.
NETLIFY_LOAD_BALANCER_IP=


# ---- Square (client payments) -----------------------------------------------
# Lives in: Worker secret.
#
# SQUARE_ENVIRONMENT defaults to sandbox. That default is deliberate: an
# unset value that charged real cards would be a much worse failure than one
# that fails to take money.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhook signature key from the Square dashboard. The signed string is the
# notification URL concatenated with the raw body, so the URL below must match
# what is configured there EXACTLY — scheme, host, path, trailing slash.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=


# ---- Scheduled jobs ---------------------------------------------------------
# Lives in: Worker secret. Shared between the Netlify scheduled function and
# /api/cron, compared in constant time. Unset means the endpoint refuses
# rather than running open.
CRON_SECRET=


# ---- Automation limits ------------------------------------------------------
# Not secret. Safe defaults; override per environment.
AGENT_DAILY_DISPATCH_CAP=10
AGENT_JOB_TIMEOUT_MINUTES=30
# Comma-separated logins whose pull requests may be merged unattended.
# Defaults to claude, claude[bot], github-actions[bot].
AGENT_PR_AUTHORS=

# Dispatch a change request to the agent the moment a client submits it,
# with no operator step. Default (unset) is OFF. Set to exactly "true" to
# enable. The daily dispatch cap above remains the backstop, and nothing
# reaches a live site without the client's own approval either way.
AGENT_AUTO_DISPATCH=


# ---- Operational ------------------------------------------------------------
BUSINESS_TIMEZONE=America/Denver
ADMIN_EMAIL=

# Guard rail: the seed script refuses to run against production unless this is
# explicitly set. Never set it in a production environment.
ALLOW_PRODUCTION_SEED=


# ---- Credentials sealed into client repositories ----------------------------
# Lives in: Worker secret. Read at scaffold time only, encrypted with the
# target repository's public key, and written as a GitHub Actions secret. Never
# stored in the database and never read back — GitHub has no API to retrieve a
# secret's value.
#
# Account-level secrets would be the obvious alternative and do not work here:
# a personal account has no shared secrets, and on GitHub Free an organisation's
# secrets are unreadable by private repositories — which client repos are.
#
# Generate with `claude setup-token` (Pro/Max). That is the subscription path;
# an ANTHROPIC_API_KEY would bill against API credits instead, and must not be
# set alongside it because it takes precedence.
CLAUDE_CODE_OAUTH_TOKEN=


# =============================================================================
# NOT IN THIS FILE, AND NEVER IN THIS REPOSITORY
# =============================================================================
#
#   CLOUDFLARE_API_TOKEN      -> GitHub Actions secret ONLY (deployments).
#
# =============================================================================
